# Copy to `keystore.properties` and fill in. That copy is gitignored, as is the
# .jks itself -- neither ever goes in the repo.
#
# Create the key first (one line, from the android/ directory):
#
#   "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" -genkeypair -v \
#     -keystore numberpop-upload.jks -alias numberpop -keyalg RSA -keysize 2048 \
#     -validity 10000
#
# It prompts for a password and for your name and locality. -validity 10000 is
# Google's own recommendation: roughly 27 years, comfortably past the 2033 floor
# Play requires of an upload key.
#
# storeFile is resolved relative to android/, so a key sitting beside this file
# is just its filename.

storeFile=numberpop-upload.jks
storePassword=
keyAlias=numberpop
keyPassword=
